    "three": "file:vendor/three-0.187.0.tgz"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
